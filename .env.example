# PPL Environment Configuration

# In production, set strong, unique random secrets (at least 32 characters).
# Generate random secrets using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-a-strong-random-key-here
SMS_TOKEN=generate-a-strong-random-sms-token-here

# Server host (default 127.0.0.1 for local security):
HOST=127.0.0.1

# Evaluation / Demo Mode:
# 0 = production mode (enforces 32+ char secrets, disables demo accounts)
# 1 = evaluation mode (allows demo credentials and seeds demo users)
DEMO_MODE=0

# Enable /inbox/simulate SMS test tool (Owner only):
# 1 = enabled, 0 = disabled
ENABLE_SIMULATOR=0
